# ---------------------------------------------------------------------------
# AeroTrade Terminal — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# On Vercel, set these under Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Database (MongoDB Atlas connection string) ---
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>"

# --- Better Auth ---
# Generate a strong secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET="your-32+-char-random-secret"
# The canonical URL of the deployment. Use http://localhost:3000 locally,
# and your production URL (e.g. https://your-app.vercel.app) in production.
# Links in production email come from lib/site.ts's PRODUCTION_URL, not from this value.
BETTER_AUTH_URL="http://localhost:3000"

# --- Google Gemini (AI chat assistant + Inngest email summaries) ---
GEMINI_API_KEY="your-gemini-api-key"
# Gemini's free tier is 20 requests a day per model, which the daily jobs already reach (the
# culture brain, the brain update, the briefing, the topic briefs, the daily brief and the lab's
# digest). Billing is enabled per Google Cloud project, so to keep a way back to the free tier
# make the paid key in a separate, billed project and name it here; AI_PLAN says which key is in
# use. "paid" without GEMINI_API_KEY_PAID falls back to the free key with a warning.
# GEMINI_API_KEY_PAID=""
# AI_PLAN="free"            # free | paid
# Chat rate limits (optional). One chat request may spend up to five model steps; the chat panel
# shows what is left of them. Defaults: 30 per user per hour, 60 per user per day, 200 for everyone per day.
# CHAT_USER_HOURLY_LIMIT=30
# CHAT_USER_DAILY_LIMIT=60
# CHAT_GLOBAL_DAILY_LIMIT=200

# --- Sign-up rate limit (optional) ---
# Sign-ups per client address per hour. Default 10; the browser QA raises it (scripts/qa/run.sh).
# SIGN_UP_CLIENT_LIMIT=10

# --- Which model runs the scheduled analysis jobs (optional) ---
# Leave unset. The default costs nothing: every background job (news-brain
# extraction, digest email, navigator rationale, welcome intro) runs on Gemini's
# free tier, exactly as before.
#
#   AI_TIER=basic   Claude Haiku for those jobs. ~$3/month at current volumes.
#   AI_TIER=pro     Claude Opus for extraction (the only call that reaches a
#                   trading decision) and Sonnet for the digest. ~$15/month.
#
# Both paid tiers need ANTHROPIC_API_KEY below; without it they fall back to the
# free tier rather than failing, so a missing key never stops the daily brain
# update. The chat assistant always stays on Gemini.
# AI_TIER="basic"

# --- Anthropic Claude (optional — paid tiers above, and the "Second Opinion" card) ---
# THREE ways to get the opinion; pick whichever suits you. Two need no key:
#
#   1. Claude subscription, automated (Pro/Max — no key, no API bill):
#        npm install -g @anthropic-ai/claude-code && claude   # log in once
#        npm run opinion:local
#      Runs on YOUR machine under YOUR login and writes the result to the
#      database, which the deployed site then renders. Requires Node 22.18+.
#      NOTE: nothing for this path belongs in this file. A subscription covers
#      you using Claude, not your server answering for other people, so no
#      Claude Code credential should ever reach your hosting provider's
#      environment. For an unattended local run see the header of
#      scripts/second-opinion-local.mjs.
#
#   2. Claude subscription, manual: press "Copy prompt for claude.ai" on /brain,
#      paste it into claude.ai, paste the answer back. No setup at all.
#
#   3. API key (below): the "Ask Claude (API)" button generates it server-side,
#      so it also works from a phone. This is a PAID API — roughly $0.05–0.15
#      per opinion at current sizes; on-demand only, 15-minute cool-down.
#      Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# --- Finnhub (stock quotes, search, company news) ---
# Read server-side only. (The older NEXT_PUBLIC_FINNHUB_API_KEY name still works.)
FINNHUB_API_KEY="your-finnhub-api-key"

# --- Tiingo (optional — the landing page's momentum terrain) ---
# With a token, the front door's terrain draws SPY's last year from Tiingo's end-of-day prices,
# adjusted for dividends and splits, fetched at most once an hour per deployment; without one it
# draws the same surface from the SPY closes the nightly price jobs store. The free tier
# (50 requests an hour, 1,000 a day) is far more than it uses. https://www.tiingo.com
# TIINGO_TOKEN="your-tiingo-token"

# --- Nodemailer (Gmail) for transactional/news emails ---
NODEMAILER_EMAIL="your-gmail-address@gmail.com"
# Use a Gmail App Password (not your account password).
NODEMAILER_PASSWORD="your-gmail-app-password"

# --- Followed topics ---
# Kill switch for every Google News RSS request: the followed-topics search, the personal
# news feed (which then falls back to the market wires) and the topic refresh cron.
# NEWS_SEARCH_ENABLED="false"

# --- News source etiquette ---
# Contact email embedded in the User-Agent for SEC EDGAR (fair-access rule) and
# Reddit requests. Falls back to a placeholder if unset.
SEC_CONTACT_EMAIL="you@example.com"

# --- Reddit (the news brain's finance subreddits and the culture brain's youth subreddits) ---
# Reddit stopped answering keyless JSON listings in May 2026, so every Reddit read goes through
# a free OAuth "script" app: create one at https://www.reddit.com/prefs/apps and paste its id
# (under the app name) and secret. One app serves both brains (100 requests a minute; the two
# jobs together make about two dozen a day). Without BOTH values every Reddit fetch is skipped,
# logged once per run, and the other sources carry on.
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""

# --- Culture brain (what younger consumers are into; one shared paper account per picker) ---
# Wikipedia pageviews and Apple's App Store charts need no key. Google News follows
# NEWS_SEARCH_ENABLED above; Reddit uses the app under "Reddit" above. Without a model key the
# daily run still stores the series and folds every brand its alias matcher finds.
#
# YouTube Data API v3 key (free: 10,000 units a day). The job spends ONE unit a day on the US
# most-popular chart. Without it the YouTube source is skipped and the run says so.
# YOUTUBE_API_KEY=""
# Optional per-brand YouTube searches a day, rotating through the catalog (100 units each; 0 = none).
# CULTURE_YOUTUBE_SEARCH_PER_DAY=0
# A paid social-trends provider (TikTok, Instagram and Snapchat publish no trend API a product
# may use): the adapter name registered in lib/culture/sources/social.ts and its key. Unset =
# no social source.
# CULTURE_SOCIAL_ADAPTER=""
# CULTURE_SOCIAL_API_KEY=""

# --- Poker night (tables friends share by link) ---
# Kill switch: "false" turns every table route into a 503 (and, from the lobby's phase, shows a note).
# POKER_NIGHT_ENABLED="false"
# The guest cookie and the seat pass are signed with keys derived from this secret, else from
# BETTER_AUTH_SECRET. Set it to rotate guests' keys on their own; put the secret it replaces in
# _PREVIOUS for a while, so seated guests keep their seats through the rotation.
# POKER_NIGHT_GUEST_SECRET="another-32+-char-random-secret"
# POKER_NIGHT_GUEST_SECRET_PREVIOUS="the-secret-it-replaced"
# Live updates: an Ably API key ("appId.keyId:secret"), read on the server only — never NEXT_PUBLIC.
# Set it in Vercel for Production only: previews, local servers, CI and the QA harness poll instead.
# In the Ably dashboard, restrict the key to channels "poker-night:*" with publish and subscribe
# (nothing else). The server publishes each table's public view on poker-night:<env>:<room id> and
# hands browsers 15-minute tokens that may only subscribe to their own table's channel. Without a
# key (or with one not shaped like a key) every table polls the server instead.
# ABLY_API_KEY="appId.keyId:secret"
# The realtime kill switch: "off" makes every table poll without removing the key (redeploy to apply).
# POKER_NIGHT_REALTIME="off"
# The shortest wait between two polls, in milliseconds (a floor under the table's own pace).
# POKER_NIGHT_POLL_MS=1500

# --- Inngest (background jobs) ---
# Jobs: welcome email, daily news email (12:00 ET), daily account snapshots
# (16:10 ET weekdays), daily news-brain update (07:30 ET), weekly AI navigator
# (Mondays 10:00 ET), topic feed refresh (every 3h), the market briefing (07:50 ET), topic briefs (08:00 ET), the
# quant strategies (09:35 ET weekdays, 10:30 retry; fills only during the session),
# interest + dividends on every account (00:05 ET daily, through yesterday), the culture
# brain's update (06:40 ET daily) and its two pickers (Mondays 10:45 ET, a Tuesday retry).
# Manual triggers: `npm run trigger -- <brain|navigator|news|snapshots|income|topics|briefs|briefing|strategies|strategies-preview|strategies-resimulate|culture|culture-weekly|culture-preview|culture-resimulate|culture-backfill|agent-world|agent-world-now|agent-world-preview>`
# with `npx inngest-cli dev` running against `npm run dev`.
# Local development only: forces the Inngest dev server. Never set this in production —
# it makes /api/inngest accept unsigned requests.
# INNGEST_DEV="1"
# Required in production (from the Inngest dashboard). Leave unset for local dev.
# INNGEST_EVENT_KEY="your-inngest-event-key"
# INNGEST_SIGNING_KEY="your-inngest-signing-key"

# --- The app's owner (its admin): the lab, both brains, the trading agent world, the strategies ---
# Comma-separated emails of the accounts that see the lab at /learn (a daily unit, review cards, the
# day's papers and their digest), the News and Culture brains, the trading agent world and the
# quant strategies, and whose enrolments the AI Navigator and the culture pickers trade. Every
# other account's /learn goes to /games and has none of the rest. Unset: nobody.
# LAB_OWNER_EMAILS="you@example.com"

# --- The Alpaca broker link (Settings › Broker; docs/specs/2026-10-24-alpaca-broker-link.md) ---
# Mirrors one of the owner's paper accounts (the AI Navigator's, a culture picker's) into an
# Alpaca account, by weight, on weekdays at 11:15 ET and on "Sync now". Paste the keys of your
# Alpaca PAPER account (Alpaca dashboard → Paper → API keys); they stay on the server.
# ALPACA_API_KEY_ID=""
# ALPACA_API_SECRET_KEY=""
# Paper unless BOTH of these say live — a live account trades real money. Switching is these two
# plus a live account's own keys in place of the paper ones.
# ALPACA_MODE="paper"            # paper | live
# ALPACA_LIVE_ENABLED=""         # "yes" alongside ALPACA_MODE=live; anything else keeps live locked
# Who may link Alpaca: these emails, or when unset the lab's owners (LAB_OWNER_EMAILS).
# BROKER_OWNER_EMAILS="you@example.com"

# --- Trading agent world (/agent-world; docs/specs/2026-10-27-trading-agent-world.md) ---
# A desk of twelve model roles (TradingAgents) reads data through OpenBB in a separate Python
# service (services/agent-world, its own .env.example), rates a few symbols each Monday and trades
# one shared paper account; Paperclip keeps the company around it. Unset, the page shows its note,
# the learn layer and the record so far, and the job runs nothing.
# AGENT_WORLD_ENABLED="true"                # "false" switches it off: the job runs nothing, the page says so
# AGENT_WORLD_SERVICE_URL="https://agent-world.example.com"   # the service; unset = not configured
# AGENT_WORLD_SERVICE_SECRET=""             # shared HMAC secret (the service's AGENT_WORLD_SECRET), both directions
# AGENT_WORLD_HEARTBEAT_SECRET=""           # what Paperclip's Execution desk sends in X-Agent-World-Heartbeat
# AGENT_WORLD_APPROVAL="owner"              # owner (Approve/Decline on the page; lapses Friday 15:30 ET or 72 h) | auto
# AGENT_WORLD_OWNER_EMAILS=""               # who may start and decide sessions; unset = LAB_OWNER_EMAILS
# AGENT_WORLD_UNIVERSE="AAPL,MSFT,NVDA"     # the symbols a session rates, at most 10
# AGENT_WORLD_CALLBACK_ORIGIN=""            # where the service posts events back; unset = this deployment's own address
# The Paperclip company (scripts/agent-world-setup.mjs creates it and prints these). The key is the
# Execution desk agent's; all three or the company layer is left out.
# PAPERCLIP_URL="http://localhost:3100"
# PAPERCLIP_API_KEY=""
# PAPERCLIP_COMPANY_ID=""
# PAPERCLIP_BOARD_URL=""                    # the board link the page shows; unset = PAPERCLIP_URL
# AGENT_WORLD_PAPERCLIP_AGENT_IDS=""        # optional "market=<id>,head-trader=<id>,…"; else agents are found by name
