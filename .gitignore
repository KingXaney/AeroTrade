# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth — scripts/qa has its own install)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# editors
.idea/
.vscode/

# local agent config (per-machine permissions)
.claude/settings.local.json
.superpowers/

# design exports
.stitch/
*.zip

# browser QA output
scripts/qa/output/
scripts/qa/package-lock.json
