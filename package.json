{
  "name": "aerotrade",
  "version": "0.1.0",
  "private": true,
  "description": "Paper-trading terminal with an AI news brain: follow topics, test strategies, and let scheduled AI jobs read the news for you.",
  "license": "MIT",
  "repository": "github:KingXaney/AeroTrade",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:db": "node scripts/test-db.mjs",
    "migrate:accounts": "node scripts/migrate-multi-account.mjs",
    "build:check": "next build --experimental-build-mode compile",
    "trigger": "node scripts/trigger.mjs",
    "opinion:local": "node scripts/second-opinion-local.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/react": "^3.0.193",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "ai": "^6.0.191",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.20",
    "fast-xml-parser": "^5.11.1",
    "inngest": "^4.21.0",
    "lucide-react": "^1.47.0",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.2",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "react-select-country-list": "^2.2.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-select-country-list": "^2.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
