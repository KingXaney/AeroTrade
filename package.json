{
  "name": "aerotrade",
  "version": "0.1.0",
  "private": true,
  "description": "Paper-trading terminal with an AI news brain: follow topics, paper-trade beside eight quant strategies, and let scheduled AI jobs read the news for you.",
  "license": "MIT",
  "repository": "github:KingXaney/AeroTrade",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:db": "node scripts/test-db.mjs",
    "migrate:accounts": "node scripts/migrate-multi-account.mjs",
    "build:check": "next build --experimental-build-mode compile",
    "trigger": "node scripts/trigger.mjs",
    "opinion:local": "node scripts/second-opinion-local.mjs",
    "qa": "bash scripts/qa/run.sh",
    "email:preview": "cd scripts/qa && node qa-email.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.130",
    "@ai-sdk/react": "^3.0.302",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "ably": "^2.29.0",
    "ai": "^6.0.299",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.17",
    "fast-xml-parser": "^5.10.1",
    "inngest": "^4.4.0",
    "lucide-react": "^1.11.0",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.1",
    "next": "^16.3.8",
    "nodemailer": "^10.0.13",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "react-select-country-list": "^2.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-select-country-list": "^2.2.3",
    "@types/three": "^0.186.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
