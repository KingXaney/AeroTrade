# services/agent-world/.env — copy this file to .env in THIS directory (never a parent one).
# The service loads it before TradingAgents is imported, and TradingAgents' own .env search is
# confined to this directory, so a .env further up (AeroTrade's own) is never read.

# Port uvicorn listens on (the Dockerfile's CMD uses 8789).
PORT=8789
# Shared HMAC secret with AeroTrade (its AGENT_WORLD_SERVICE_SECRET); at least 16 characters. Required.
AGENT_WORLD_SECRET=
# AeroTrade's base URL: the only origin events and the Paperclip relay may be sent to. Required.
AEROTRADE_URL=http://localhost:3000
# The value Paperclip's http-adapter agents send in X-Agent-World-Heartbeat (AeroTrade's AGENT_WORLD_HEARTBEAT_SECRET); unset turns the heartbeat route off.
PAPERCLIP_HEARTBEAT_SECRET=

# Paperclip's base URL; unset (with the next two) leaves Paperclip out entirely.
PAPERCLIP_URL=
# The Head trader agent's API key: preflight budget check, a run on the session's issue, comments, done.
PAPERCLIP_API_KEY=
# The Paperclip company the desk lives in.
PAPERCLIP_COMPANY_ID=
# JSON {roleId: key} of each role agent's own key, so its cost events are filed as itself; a role without one reports through the Head trader with billingCode "role:<id>".
PAPERCLIP_ROLE_KEYS={}

# Model provider: google or anthropic.
AGENT_WORLD_LLM_PROVIDER=google
# The quick tier: the four analysts, the bull and bear, the trader and the three risk analysts.
AGENT_WORLD_QUICK_MODEL=gemini-2.5-flash-lite
# The deep tier: the research manager and the portfolio manager.
AGENT_WORLD_DEEP_MODEL=gemini-2.5-flash
# The paid Gemini key (Google's SDK also reads GEMINI_API_KEY); needed when the provider is google.
GOOGLE_API_KEY=
# Anthropic's key; needed when the provider is anthropic.
ANTHROPIC_API_KEY=

# Bull/bear rounds before the research manager decides (1-5).
AGENT_WORLD_MAX_DEBATE_ROUNDS=1
# Rounds of the three risk analysts before the portfolio manager decides (1-5).
AGENT_WORLD_MAX_RISK_ROUNDS=1
# Rounds of tool calls an analyst may make before it must write its report (1-40).
AGENT_WORLD_MAX_TOOL_ROUNDS=8
# Seconds one symbol's run may take before it is reported as timed out (30-7200).
AGENT_WORLD_RUN_TIMEOUT_S=600

# JSON price overrides, USD per 1M tokens: {"gemini-3.5-flash": [0.3, 2.5]} (longest model-id prefix wins).
AGENT_WORLD_PRICES=
# JSON chain overrides per TradingAgents category: {"news_data": "yfinance"}.
AGENT_WORLD_DATA_VENDORS=
# Free FRED key for the macro tool (TradingAgents' FRED pins the vintage); without it macro data is skipped.
FRED_API_KEY=
# Your name and email for SEC EDGAR, which refuses anonymous clients: "Jane Doe jane@example.com".
SEC_EDGAR_USER_AGENT=
# Where TradingAgents' results, cache and memory log and OpenBB's settings and cache live (default ./.data; /data in Docker).
AGENT_WORLD_DATA_DIR=
